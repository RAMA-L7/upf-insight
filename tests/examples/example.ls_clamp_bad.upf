# example.ls_clamp_bad.upf — isolation/level-shifter edge-case fixture.
#
#   * UPF-061 — DLO (vdd, 0.8 V) and DHI (vdd_hv, 1.8 V) differ in voltage but
#     neither declares a level shifter. Voltages are declared via NON-"ON"-named
#     states ({VDD_LOW 0.8}, {VDD_HV 1.8}) to prove the voltage fallback works.
#   * UPF-046 (warning) — iso_noclamp has no -clamp_value, so its outputs float
#     while isolation is active.
upf_version 3.0
set_design_top ls_top

create_supply_port vdd -direction in
create_supply_net vdd -resolve port
create_supply_net vdd_hv -resolve port

create_power_domain DLO -elements {u1}
create_power_domain DHI -elements {u2}
set_domain_supply_net DLO -primary_power_net vdd
set_domain_supply_net DHI -primary_power_net vdd_hv

# Nominal voltages under non-"ON" state names, plus an OFF (0 V) state.
add_port_state vdd -state {VDD_LOW 0.8} -state {OFF 0.0}
add_port_state vdd_hv -state {VDD_HV 1.8} -state {OFF 0.0}

# Isolation with a control signal but no clamp value -> UPF-046 warning.
set_isolation iso_noclamp -domain DLO -isolation_signal iso_en -applies_to outputs