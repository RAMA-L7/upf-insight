# cpu_subsys_v2.upf - realistic CPU-subsystem power intent (REGRESSED).
#
# Identical to V1 except ONE subtle, realistic defect: the level shifter on
# the 1.8 V I/O boundary has been removed (an engineer "simplified" the
# crossing during a refactor). The CPU (1.0 V) and I/O (1.8 V) domains now
# cross voltage domains with no level shifter - UPF-061 must fire.
#
# Do NOT reveal this planted regression in the user-facing Test Drive.
upf_version 3.0
set_design_top cpu_subsys

# ---- Supply network ----
create_supply_port vdd_ao -direction in
create_supply_net vdd_ao -resolve port
connect_supply_net vdd_ao -ports vdd_ao

create_supply_port vss -direction in
create_supply_net vss -resolve port
connect_supply_net vss -ports vss

create_supply_port vdd_io -direction in
create_supply_net vdd_io -resolve port
connect_supply_net vdd_io -ports vdd_io

create_supply_net vdd_sw -resolve net
create_supply_net vdd_ret -resolve net

create_supply_set ps_ao  -function {power vdd_ao} -function {ground vss}
create_supply_set ps_cpu -function {power vdd_sw} -function {ground vss}
create_supply_set ps_io  -function {power vdd_io} -function {ground vss}
create_supply_set ps_ret -function {power vdd_ret} -function {ground vss}

# ---- Power switch (CPU domain) ----
create_power_switch sw_cpu -input_supply_port vdd_ao -output_supply_port vdd_sw \
    -control_port pwr_ok -on_state {on vdd_ao {pwr_ok}} -off_state {off vdd_ao {!pwr_ok}}

# ---- Power domains ----
create_power_domain PD_CPU  -elements {u_cpu}  -primary_supply_set ps_cpu
create_power_domain PD_AO   -elements {u_ao}   -primary_supply_set ps_ao
create_power_domain PD_IO   -elements {u_io}   -primary_supply_set ps_io
create_power_domain PD_SRAM -elements {u_sram} -primary_supply_set ps_ret

# ---- Power states / PST ----
add_port_state vdd_ao  -state {ON 1.0}
add_port_state vdd_sw  -state {ON 1.0} -state {OFF 0.0}
add_port_state vdd_io  -state {ON 1.8} -state {OFF 0.0}
add_port_state vdd_ret -state {ON 1.0}
add_port_state vss     -state {ON 0.0}

create_pst pst_cpu -supplies {vdd_ao vdd_sw vdd_io vdd_ret vss}
add_pst_state PS_RUN      -pst pst_cpu -state {vdd_ao ON vdd_sw ON vdd_io ON vdd_ret ON vss ON}
add_pst_state PS_CPU_OFF  -pst pst_cpu -state {vdd_ao ON vdd_sw OFF vdd_io ON vdd_ret ON vss ON}
add_pst_state PS_STANDBY  -pst pst_cpu -state {vdd_ao ON vdd_sw OFF vdd_io OFF vdd_ret ON vss ON}
add_state_transition PS_RUN -next_state PS_CPU_OFF
add_state_transition PS_CPU_OFF -next_state PS_RUN
add_state_transition PS_RUN -next_state PS_STANDBY
add_state_transition PS_STANDBY -next_state PS_RUN

# ---- Strategies ----
# Isolation on the switchable CPU boundary, located in the always-on parent,
# clamped low, covering outputs/inputs/inouts, controlled by iso_en.
set_isolation iso_cpu -domain PD_CPU -isolation_supply ps_ao -clamp_value 0 \
    -location parent -applies_to outputs,inputs,inout -isolation_signal iso_en
set_isolation_control iso_cpu -domain PD_CPU -isolation_signal iso_en \
    -isolation_sense high

# >>> REGRESSION: set_level_shifter ls_io ... removed here <<<

# Retention for the switchable CPU domain and the SRAM domain.
set_retention ret_cpu  -domain PD_CPU  -retention_supply ps_ret \
    -save_signal save -restore_signal restore -elements {u_cpu}
set_retention ret_sram -domain PD_SRAM -retention_supply ps_ret \
    -save_signal save -restore_signal restore -elements {u_sram}

# ---- Always-on attributes (controls must never be powered down) ----
set_port_attributes iso_en -attribute {always_on true}
