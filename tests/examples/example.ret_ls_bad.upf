# example.ret_ls_bad.upf - golden fixture exercising retention + level-shifter rules.
upf_version 3.0
set_design_top rl_top

create_supply_port vdd -direction in
create_supply_port vdd_hv -direction in
create_supply_port vss -direction in
create_supply_net vdd -resolve port
create_supply_net vdd_hv -resolve port
create_supply_net vss -resolve port
connect_supply_net vdd -ports vdd
connect_supply_net vdd_hv -ports vdd_hv
connect_supply_net vss -ports vss

create_supply_set primary -function {power vdd} -function {ground vss}
create_supply_set hv -function {power vdd_hv} -function {ground vss}

# Voltage states for the LS rules (UPF-061/062).
add_port_state vdd -state {ON 0.8} -state {OFF 0.0}
add_port_state vdd_hv -state {ON 1.8}

create_power_domain PD_LO -elements {u_lo} -primary_supply_set primary
create_power_domain PD_HI -elements {u_hi} -primary_supply_set hv

# Bad: save and restore on the same signal -> UPF-053.
set_retention ret_bad -domain PD_LO -retention_supply primary \
    -save_signal ctrl -restore_signal ctrl
# Bad: level shifter on PD_HI (1.8V) to PD_LO (0.8V) needs high_to_low,
#   but declares low_to_high -> UPF-062.
set_level_shifter ls_wrong -domain PD_HI -rule low_to_high
