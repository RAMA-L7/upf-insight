# Generated by upf-insight generate
upf_version 3.0

set_design_top top

# -- Power domains ----
create_power_domain core \
    -elements {u_core}
create_power_domain io \
    -elements {u_io}
set_port_attributes io -attribute {always_on true}
create_power_domain sram \
    -elements {u_sram}
set_port_attributes sram -attribute {always_on true}

# -- Supply network ----
create_supply_port vdd -direction in
create_supply_net vdd -resolve port
connect_supply_net vdd -ports vdd
create_supply_port vss -direction in
create_supply_net vss -resolve port
connect_supply_net vss -ports vss
create_supply_set primary \
    -function {power vdd} \
    -function {ground vss}
create_supply_net vdd_sw_out -resolve net
connect_supply_net vdd_sw_out -ports vdd
set_domain_supply_net core \
    -primary_power_net vdd_sw_out \
    -primary_ground_net vss
set_domain_supply_net io \
    -primary_power_net vdd \
    -primary_ground_net vss
set_domain_supply_net sram \
    -primary_power_net vdd \
    -primary_ground_net vss

# -- Auxiliary supplies ----
create_supply_net vdd_iso -resolve net
connect_supply_net vdd_iso -ports vdd
create_supply_net vdd_ret -resolve net
connect_supply_net vdd_ret -ports vdd

# -- Power switches ----
create_power_switch sw_core \
    -input_supply_port vdd \
    -output_supply_port vdd_sw_out \
    -control_port pwr_en \
    -on_state {on {vdd} {pwr_en}} \
    -off_state {off {vdd} {!pwr_en}}

# -- Isolation ----
set_isolation iso_core \
    -domain core \
    -isolation_supply vdd_iso \
    -clamp_value 0 \
    -applies_to outputs \
    -location parent
set_isolation_control iso_core \
    -domain core \
    -isolation_signal iso_en \
    -isolation_sense high

# -- Level shifters ----
set_level_shifter ls_core \
    -domain core \
    -location parent \
    -threshold 0.8 \
    -applies_to both \
    -rule low_to_high

# -- Power states / PST ----
add_port_state vdd \
    -state {ON 1.0}
add_port_state vss \
    -state {ON 0.0}
add_port_state vdd_sw_out \
    -state {ON 0.8} \
    -state {OFF 0.0}
create_pst pst_top \
    -supplies {vdd vss vdd_sw_out}
add_pst_state ALL_ON \
    -pst pst_top \
    -state {vdd ON vss ON vdd_sw_out ON}
add_pst_state sw_core.off \
    -pst pst_top \
    -state {vdd ON vss ON vdd_sw_out OFF}

# -- Retention ----
create_supply_set retention \
    -function {power vdd_ret} \
    -function {ground vss}
set_retention ret_core \
    -domain core \
    -retention_supply retention \
    -elements {regA regB}
set_retention_control ret_core \
    -domain core \
    -save_signal {save high} \
    -restore_signal {restore low}

# -- Always-on signals ----
set_port_attributes clk, rst -attribute {always_on true}
