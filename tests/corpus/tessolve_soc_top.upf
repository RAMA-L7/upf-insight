
############################################################
# UPF HEADER
############################################################
upf_version 2.1
set_design_top top

############################################################
# SUPPLY PORTS
############################################################
create_supply_port VDD_TOP
create_supply_port VDD_CPU
create_supply_port VDD_GPU
create_supply_port VDD_SRAM
create_supply_port VSS

############################################################
# PORT VOLTAGE STATES
############################################################

add_port_state VDD_TOP \
   -state { ON 1.0 }

add_port_state VDD_CPU \
   -state { ON 0.9 }

add_port_state VDD_GPU \
   -state { ON 0.8 }

add_port_state VDD_SRAM \
   -state { ON 0.8 }

############################################################
# SUPPLY NETS
############################################################

create_supply_net vdd_top_net
connect_supply_net vdd_top_net \
   -ports { VDD_TOP }

create_supply_net vdd_cpu_net
connect_supply_net vdd_cpu_net \
   -ports { VDD_CPU }

create_supply_net vdd_gpu_net
connect_supply_net vdd_gpu_net \
   -ports { VDD_GPU }

create_supply_net vdd_sram_net
connect_supply_net vdd_sram_net \
   -ports { VDD_SRAM }

create_supply_net gnd_net
connect_supply_net gnd_net \
   -ports { VSS }

############################################################
# SUPPLY SETS
############################################################

create_supply_set SS_PD_TOP \
   -function { power  vdd_top_net } \
   -function { ground gnd_net }

create_supply_set SS_PD_CPU \
   -function { power  vdd_cpu_net } \
   -function { ground gnd_net }

create_supply_set SS_PD_GPU \
   -function { power  vdd_gpu_net } \
   -function { ground gnd_net }

create_supply_set SS_PD_SRAM \
   -function { power  vdd_sram_net } \
   -function { ground gnd_net }

############################################################
# POWER DOMAINS
############################################################

create_power_domain PD_TOP \
   -include_scope \
   -supply { primary SS_PD_TOP }

create_power_domain PD_CPU \
   -elements { top/cpu } \
   -supply   { primary SS_PD_CPU }

create_power_domain PD_GPU \
   -elements { top/gpu } \
   -supply   { primary SS_PD_GPU }

create_power_domain PD_SRAM \
   -elements { top/sram } \
   -supply   { primary SS_PD_SRAM }

############################################################
# POWER SWITCHES
############################################################

create_power_switch SW_CPU \
   -domain           PD_CPU \
   -input_supply     { vdd_top_net } \
   -output_supply    { vdd_cpu_net } \
   -control_port     CPU_PWR_EN \
   -on_state         { SW_CPU_ON vdd_top_net {!CPU_PWR_EN} }

map_power_switch SW_CPU my_lib/power_switch_cell

create_power_switch SW_GPU \
   -domain           PD_GPU \
   -input_supply     { vdd_top_net } \
   -output_supply    { vdd_gpu_net } \
   -control_port     GPU_PWR_EN \
   -on_state         { SW_GPU_ON vdd_top_net {!GPU_PWR_EN} }

map_power_switch SW_GPU my_lib/power_switch_cell

create_power_switch SW_SRAM \
   -domain           PD_SRAM \
   -input_supply     { vdd_top_net } \
   -output_supply    { vdd_sram_net } \
   -control_port     SRAM_PWR_EN \
   -on_state         { SW_SRAM_ON vdd_top_net {!SRAM_PWR_EN} }

map_power_switch SW_SRAM my_lib/power_switch_cell

############################################################
# ISOLATION / LEVEL SHIFTER / RETENTION
############################################################

set_isolation ISO_PD_CPU \
   -domain PD_CPU \
   -elements { top/cpu/out_bus } \
   -isolation_power_net  vdd_top_net \
   -isolation_ground_net gnd_net \
   -clamp_value 0

set_isolation_control ISO_PD_CPU \
   -domain PD_CPU \
   -isolation_signal pmu/iso_cpu \
   -isolation_sense low \
   -location parent

map_isolation_cell ISO_PD_CPU my_lib/iso_cell

set_level_shifter LS_PD_CPU_TO_PD_TOP \
   -domain PD_CPU \
   -applies_to outputs \
   -rule low_to_high \
   -location self

map_level_shifter_cell LS_PD_CPU_TO_PD_TOP my_lib/level_shifter_cell

set_isolation ISO_PD_GPU \
   -domain PD_GPU \
   -elements {  } \
   -isolation_power_net  vdd_top_net \
   -isolation_ground_net gnd_net \
   -clamp_value 0

set_isolation_control ISO_PD_GPU \
   -domain PD_GPU \
   -isolation_signal pmu/iso_gpu \
   -isolation_sense low \
   -location parent

map_isolation_cell ISO_PD_GPU my_lib/iso_cell

set_level_shifter LS_PD_GPU_TO_PD_TOP \
   -domain PD_GPU \
   -applies_to outputs \
   -rule low_to_high \
   -location self

map_level_shifter_cell LS_PD_GPU_TO_PD_TOP my_lib/level_shifter_cell

set_isolation ISO_PD_SRAM \
   -domain PD_SRAM \
   -elements { top/sram/out_bus } \
   -isolation_power_net  vdd_top_net \
   -isolation_ground_net gnd_net \
   -clamp_value 1

set_isolation_control ISO_PD_SRAM \
   -domain PD_SRAM \
   -isolation_signal pmu/iso_sram \
   -isolation_sense low \
   -location parent

map_isolation_cell ISO_PD_SRAM my_lib/iso_cell

set_retention RET_PD_SRAM \
   -domain PD_SRAM \
   -elements { top/sram/reg* } \
   -retention_power_net vdd_top_net \
   -retention_ground_net gnd_net

set_retention_control RET_PD_SRAM \
   -domain PD_SRAM \
   -save_signal    { pmu/ret_en high } \
   -restore_signal { pmu/ret_en low }

map_retention_cell RET_PD_SRAM my_lib/retention_cell
